 %import common.CNAME    -> IDENT
 %import common.HEXDIGIT -> HEXDIGIT
 %import common.DIGIT    -> DIGIT
 %import common.SH_COMMENT

start: stmt*

?stmt: local_label_def
    | label_def
    | directive_block
    | instruction
    | _NEWLINE

label_def: IDENT ":"
local_label_def: "@" IDENT ":"

?directive_block: data 
                | macro
                | byte
                | word
                | dword
                | ascii
                | asciiz
                | fill
                | reserve
                | literal_pool

data: ".data" (local_label_def | label_def | value | _NEWLINE)* ".endd" _NEWLINE
macro: ".macro" args _NEWLINE stmt+ ".endm" _NEWLINE
byte: ".byte"  NUMBER ("," NUMBER)* _NEWLINE
word: ".word"  value ("," value)* _NEWLINE
dword: ".dword"  NUMBER ("," NUMBER)* _NEWLINE
ascii: ".ascii" string _NEWLINE
asciiz: ".asciiz" string _NEWLINE
fill: ".fill" NUMBER "," NUMBER _NEWLINE
reserve: ".res" NUMBER _NEWLINE
literal_pool: ".literals" _NEWLINE


instruction: IDENT args? _NEWLINE
args: value ("," value)*

?value: LOCAL_LABEL? IDENT | NUMBER | literal | QMARK
literal: "#" NUMBER
NUMBER: "-"? (DEC_INT | HEX_INT | BIN_INT)
LOCAL_LABEL: "@"
DEC_INT: DIGIT+
HEX_INT: "$" HEXDIGIT+
BIN_INT: "%" BINDIGIT+

BINDIGIT: "0" | "1"

QMARK: "?"

_NEWLINE: "\n"

string: "\"" ASCII_CHAR* "\""
ASCII_CHAR: /[^"\\\n\r]/ | ESCAPED_CHAR
ESCAPED_CHAR: "\\" /["\\nrt0]/

%ignore /[ \t]+/
%ignore /;[^\n]*/
