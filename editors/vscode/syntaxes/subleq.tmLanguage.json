{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SUBLEQ",
  "scopeName": "source.subleq",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#macroDefinitions"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#instructions"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#specialValues"
    },
    {
      "include": "#labelReferences"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.subleq",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.subleq",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.subleq",
              "match": "\\\\[\"\\\\nrt0]"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "constant.character.subleq",
          "match": "'(?:[^'\\\\\\n\\r]|\\\\['\\\\nrt0])'?"
        }
      ]
    },
    "macroDefinitions": {
      "patterns": [
        {
          "begin": "^(\\s*)(\\.macro)(\\s+)((?:(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*))(?=\\s|,|$)",
          "beginCaptures": {
            "2": {
              "name": "keyword.control.directive.macro.subleq"
            },
            "4": {
              "name": "entity.name.function.macro.subleq"
            }
          },
          "end": "^(\\s*)(\\.endm)\\b",
          "endCaptures": {
            "2": {
              "name": "keyword.control.directive.macro.subleq"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#macroLabels"
            },
            {
              "include": "#directives"
            },
            {
              "include": "#instructions"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#specialValues"
            }
          ]
        }
      ]
    },
    "macroLabels": {
      "patterns": [
        {
          "name": "variable.other.label.subleq",
          "match": "@?(?:(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*)(?=\\s*:)"
        },
        {
          "name": "variable.other.label.subleq",
          "match": "@(?:(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*)"
        },
        {
          "name": "variable.other.label.subleq",
          "match": "(?<![A-Za-z0-9_])(?:(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*)(?![A-Za-z0-9_])"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "variable.other.label.subleq",
          "match": "@(?:(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*)(?=\\s*:)"
        },
        {
          "name": "variable.other.label.subleq",
          "match": "(?<![A-Za-z0-9_])(?:(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*)(?=\\s*:)"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.subleq",
          "match": "\\.(?:data|endd|macro|endm|byte|word|dword|char|ascii|asciiz|fill|res|literals|bootstrap|include|test|endt|set|assert|assert\\-output)\\b"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "keyword.control.instruction.subleq",
          "match": "\\bsubleq\\b"
        },
        {
          "name": "support.function.macro.subleq",
          "match": "^(?:\\s*)((?:(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*))(?=\\s|$)",
          "captures": {
            "1": {
              "name": "support.function.macro.subleq"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.immediate.subleq",
          "match": "#-?(?:\\$[A-Fa-f0-9]+|%[01]+|\\d+)(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.hex.subleq",
          "match": "-?\\$[A-Fa-f0-9]+(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.binary.subleq",
          "match": "-?%[01]+(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.decimal.subleq",
          "match": "(?<![A-Za-z0-9_])-?\\d+(?![A-Za-z0-9_])"
        }
      ]
    },
    "specialValues": {
      "patterns": [
        {
          "name": "constant.language.next-address.subleq",
          "match": "\\?"
        }
      ]
    },
    "labelReferences": {
      "patterns": [
        {
          "name": "variable.other.label.subleq",
          "match": "@(?:(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*)"
        },
        {
          "name": "variable.other.label.subleq",
          "match": "(?<![A-Za-z0-9_])(?:(?:(?:[A-Z]|[a-z])|_)(?:(?:(?:[A-Z]|[a-z])|[0-9]|_))*)(?![A-Za-z0-9_])"
        }
      ]
    }
  }
}
